# ─── SIGNBRIDGE Backend Environment Variables ──────────────────────────────
#
# Copy this file to `.env` and set real values before running the server.
# The application loads this file automatically via python-dotenv.
#
# Usage:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
# Host and port used by Uvicorn (override on the CLI or here)
HOST=0.0.0.0
PORT=8000

# ── Environment ───────────────────────────────────────────────────────────
# Set to "production" to suppress debug output
ENVIRONMENT=development

# ── Model ─────────────────────────────────────────────────────────────────
# Absolute or relative path to the trained Keras model.
# Leave blank to use the default: app/models/isl_model.keras
# ISL_MODEL_PATH=app/models/isl_model.keras

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (beyond the defaults).
# Example: EXTRA_CORS_ORIGINS=https://signbridge.example.com
# EXTRA_CORS_ORIGINS=
